# ─── Ollama Settings ──────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral                   # or mistral:7b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ─── App Settings ─────────────────────────────────────────────────
APP_NAME="ResumeAI"
APP_ENV=development                    # development | production
LOG_LEVEL=DEBUG

# ─── Vector DB (ChromaDB - fully local) ───────────────────────────
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_RESUME_COLLECTION=resumes
CHROMA_JD_COLLECTION=job_descriptions

# ─── API Settings ─────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true

# ─── Agent Settings ───────────────────────────────────────────────
AGENT_MAX_RETRIES=3
AGENT_TIMEOUT_SECONDS=120
SCREENER_TOP_K=20                      # candidates retrieved from vector DB before re-ranking
RECOMMENDER_TOP_K=10                   # jobs recommended per candidate
